@model BrainHugeAcademy.Models.CourseModule
@{
    ViewData["Title"] = Model.Title;
    var progress = (BrainHugeAcademy.Models.ModuleProgress?)ViewBag.Progress;
    var enrollment = (BrainHugeAcademy.Models.Enrollment)ViewBag.Enrollment;
    var allModules = (IEnumerable<dynamic>)ViewBag.AllModules;
}

<section class="page-header page-header-compact">
    <div class="container">
        <div class="breadcrumb-row">
            <a href="/Learner/MyCourses"><i class="fas fa-arrow-left"></i> Mes Cours</a>
            <a href="/Learner/Module?courseId=@Model.CourseId&moduleId=@Model.Id" class="btn btn-sm btn-ai" style="margin-left:auto">
                <i class="fas fa-brain"></i> Demander à Nova
            </a>
        </div>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </div>
</section>

<section class="module-content-section">
    <div class="container module-layout">
        <aside class="module-sidebar">
            <h4>Modules</h4>
            @foreach (var m in allModules)
            {
                <a href="/Learner/Module?courseId=@Model.CourseId&moduleId=@m.Id"
                   class="sidebar-link @(m.Id == Model.Id ? "active" : "")">
                    <span class="sidebar-num">@(m.OrderIndex.ToString("D2"))</span>
                    @m.Title
                </a>
            }
        </aside>

        <div class="module-main">
            <div class="module-intro">
                <h2>Aperçu du Module</h2>
                <div class="module-content-text">
                    @Model.Content
                </div>
            </div>

            <div class="lessons-section">
                <h3><i class="fas fa-book-open"></i> Leçons</h3>
                @foreach (var lesson in Model.Lessons)
                {
                    <div class="lesson-card">
                        <div class="lesson-badge">@lesson.LessonType</div>
                        <h4>@lesson.Title</h4>
                        <p>@lesson.Content</p>
                    </div>
                }
            </div>

            @if (Model.Quizzes.Any())
            {
                <div class="quiz-section">
                    <h3><i class="fas fa-question-circle"></i> Quiz du Module</h3>
                    @foreach (var quiz in Model.Quizzes)
                    {
                        <div class="quiz-block">
                            <h4>@quiz.Title</h4>
                            <form id="quizForm" class="quiz-form">
                                @foreach (var q in quiz.Questions)
                                {
                                    <div class="quiz-question" data-correct="@q.CorrectOption">
                                        <p class="question-text"><strong>@q.QuestionText</strong></p>
                                        <div class="options-grid">
                                            <label class="option">
                                                <input type="radio" name="q_@q.Id" value="A" />
                                                <span class="option-label">A</span> @q.OptionA
                                            </label>
                                            <label class="option">
                                                <input type="radio" name="q_@q.Id" value="B" />
                                                <span class="option-label">B</span> @q.OptionB
                                            </label>
                                            <label class="option">
                                                <input type="radio" name="q_@q.Id" value="C" />
                                                <span class="option-label">C</span> @q.OptionC
                                            </label>
                                            <label class="option">
                                                <input type="radio" name="q_@q.Id" value="D" />
                                                <span class="option-label">D</span> @q.OptionD
                                            </label>
                                        </div>
                                        <div class="explanation hidden">
                                            <i class="fas fa-lightbulb"></i> @q.Explanation
                                        </div>
                                    </div>
                                }
                                <button type="button" class="btn btn-primary btn-lg" onclick="submitQuiz(@quiz.Questions.Count, @enrollment.Id, @Model.Id)">
                                    Soumettre les Réponses
                                </button>
                            </form>
                            <div id="quizResult" class="quiz-result hidden">
                                <div class="result-score"></div>
                                <div class="result-message"></div>
                                <a href="/Learner/MyCourses" class="btn btn-primary">Retour à Mes Cours</a>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (progress != null && progress.IsCompleted)
            {
                <div style="text-align:center;padding:1.5rem 0;">
                    <svg width="90" height="90" viewBox="0 0 90 90" fill="none" xmlns="http://www.w3.org/2000/svg" class="stamp-svg" style="transform:rotate(-8deg);">
                        <circle cx="45" cy="45" r="40" stroke="#B4432F" stroke-width="3" stroke-dasharray="5 3" fill="rgba(180,67,47,0.06)" />
                        <text x="45" y="38" text-anchor="middle" fill="#B4432F" font-family="Georgia,serif" font-size="11" font-weight="700" letter-spacing="1">VALIDÉ</text>
                        <text x="45" y="55" text-anchor="middle" fill="#B4432F" font-family="'IBM Plex Mono',monospace" font-size="14" font-weight="600">@(Model.OrderIndex.ToString("D2"))</text>
                    </svg>
                    <p style="margin-top:0.5rem;color:#5B7B5E;font-weight:500;font-size:0.9rem;">Module Terminé ! Score : @progress.QuizScore / @progress.QuizTotal</p>
                </div>
            }
        </div>
    </div>
</section>

<form id="completeForm" asp-controller="Learner" asp-action="CompleteModule" method="post" style="display:none">
    <input type="hidden" name="enrollmentId" value="@enrollment.Id" />
    <input type="hidden" name="moduleId" value="@Model.Id" />
    <input type="hidden" name="score" id="scoreInput" />
    <input type="hidden" name="total" id="totalInput" />
</form>

@section Scripts {
<script>
function submitQuiz(total, enrollmentId, moduleId) {
    const questions = document.querySelectorAll('.quiz-question');
    let score = 0;
    let answered = 0;

    questions.forEach(q => {
        const correct = q.dataset.correct;
        const selected = q.querySelector('input:checked');
        const explanation = q.querySelector('.explanation');

        q.querySelectorAll('.option').forEach(opt => {
            const input = opt.querySelector('input');
            if (input.value === correct) {
                opt.classList.add('correct');
            }
            if (input.checked && input.value !== correct) {
                opt.classList.add('wrong');
            }
        });

        if (selected) {
            answered++;
            if (selected.value === correct) score++;
        }

        explanation.classList.remove('hidden');
    });

    document.getElementById('scoreInput').value = score;
    document.getElementById('totalInput').value = total;
    document.getElementById('completeForm').submit();
}
</script>
}
