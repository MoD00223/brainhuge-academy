@model BrainHugeAcademy.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Créer un Compte";
}

<section class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <span class="brand-icon">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="24" cy="24" r="21" stroke="#C98A2C" stroke-width="1.5" stroke-dasharray="4 4"/>
                    <circle cx="24" cy="24" r="16" fill="#16323F"/>
                    <text x="24" y="30" text-anchor="middle" font-family="'Fraunces', serif" font-size="20" font-weight="700" fill="#F5F6F3">B</text>
                </svg>
            </span>
            <h1>Rejoignez BrainHuge Academy</h1>
            <p>Créez votre compte gratuit et commencez à apprendre avec BrainHuge.</p>
        </div>
        <form asp-controller="Account" asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="All" class="validation-summary"></div>
            <div class="form-group">
                <label asp-for="DisplayName"></label>
                <input asp-for="DisplayName" class="form-input" placeholder="Votre nom" />
                <span asp-validation-for="DisplayName" class="field-validation"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-input" placeholder="vous@email.com" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-input" placeholder="Minimum 6 caractères" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-input" placeholder="Confirmer le mot de passe" />
                <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg">Créer le Compte</button>
        </form>
        <div class="auth-footer">
            Vous avez déjà un compte ? <a href="/Account/Login">Connectez-vous</a>
        </div>
    </div>
</section>