@model BrainHugeAcademy.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Connexion";
}

<section class="auth-page">
    <div class="auth-card">
        <div class="auth-header">
            <span class="brand-icon">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="24" cy="24" r="21" stroke="#C98A2C" stroke-width="1.5" stroke-dasharray="4 4"/>
                    <circle cx="24" cy="24" r="16" fill="#16323F"/>
                    <text x="24" y="30" text-anchor="middle" font-family="'Fraunces', serif" font-size="20" font-weight="700" fill="#F5F6F3">B</text>
                </svg>
            </span>
            <h1>Bon Retour</h1>
            <p>Connectez-vous pour poursuivre votre parcours d'apprentissage avec BrainHuge.</p>
        </div>
        <form asp-controller="Account" asp-action="Login" method="post" class="auth-form">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div asp-validation-summary="All" class="validation-summary"></div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-input" placeholder="vous@email.com" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-input" placeholder="Votre mot de passe" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>
            <div class="form-group form-check">
                <label class="checkbox-label">
                    <input asp-for="RememberMe" type="checkbox" />
                    Se souvenir de moi
                </label>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg">Se Connecter</button>
        </form>
        <div class="auth-footer">
            Pas encore de compte ? <a href="/Account/Register">Inscrivez-vous gratuitement</a>
        </div>
    </div>
</section>