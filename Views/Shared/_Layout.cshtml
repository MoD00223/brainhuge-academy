@{
    ViewData["Title"] = ViewData["Title"] ?? "BrainHuge Academy";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrainHuge Academy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="rail">
        <a href="/" class="rail-logo" title="BrainHuge Academy">
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="18" cy="18" r="16" stroke="#C98A2C" stroke-width="2" stroke-dasharray="4 3" />
                <circle cx="18" cy="18" r="12" fill="#16323F" />
                <text x="18" y="23" text-anchor="middle" fill="#C98A2C" font-family="Georgia,serif" font-size="16" font-weight="700">B</text>
            </svg>
        </a>

        <a href="/" class="rail-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
            <i class="fas fa-home"></i>
            <span>Accueil</span>
        </a>
        <a href="/Learner/Catalog" class="rail-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Learner" && ViewContext.RouteData.Values["action"]?.ToString() == "Catalog" ? "active" : "")">
            <i class="fas fa-compass"></i>
            <span>Catalogue</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/Learner/MyCourses" class="rail-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyCourses" || ViewContext.RouteData.Values["action"]?.ToString() == "Module" ? "active" : "")">
                <i class="fas fa-book-open"></i>
                <span>Mes Cours</span>
            </a>
            <a href="/AiTutor/Chat" class="rail-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AiTutor" ? "active" : "")">
                <i class="fas fa-brain"></i>
                <span>Nova</span>
            </a>
        }
        else
        {
            <a href="/Account/Login" class="rail-link">
                <i class="fas fa-sign-in-alt"></i>
                <span>Connexion</span>
            </a>
            <a href="/Account/Register" class="rail-link">
                <i class="fas fa-user-plus"></i>
                <span>Commencer</span>
            </a>
        }

        <div class="rail-spacer"></div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <span class="rail-user"><i class="fas fa-user-circle"></i></span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="rail-form">
                <button type="submit" class="rail-link" style="border:none;background:none;cursor:pointer;font-family:inherit;">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>Déco</span>
                </button>
            </form>
        }
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" style="vertical-align:middle;">
                        <circle cx="18" cy="18" r="16" stroke="#C98A2C" stroke-width="2" stroke-dasharray="4 3" />
                        <circle cx="18" cy="18" r="12" fill="#16323F" />
                        <text x="18" y="23" text-anchor="middle" fill="#C98A2C" font-family="Georgia,serif" font-size="16" font-weight="700">B</text>
                    </svg>
                    <span style="font-family:'Fraunces',serif;font-weight:700;font-size:1.05rem;color:#16323F;margin-left:0.4rem;">BrainHuge<span style="color:#C98A2C;">Academy</span></span>
                    <p class="footer-tagline">Votre compagnon d'apprentissage propulsé par l'IA. Apprenez plus intelligemment, retenez plus vite, progressez sans limites.</p>
                </div>
                <div class="footer-col">
                    <h4>Explorer</h4>
                    <a href="/Learner/Catalog">Catalogue</a>
                    <a href="/Learner/MyCourses">Mes Cours</a>
                    <a href="/AiTutor/Chat">Tuteur IA Nova</a>
                </div>
                <div class="footer-col">
                    <h4>Stack Technique</h4>
                    <span>ASP.NET Core MVC</span>
                    <span>Entity Framework Core</span>
                    <span>SQLite</span>
                    <span>Moteur IA Nova</span>
                </div>
            </div>
            <div class="footer-bottom">
                <p>Construit avec passion. Propulsé par l'IA. &copy; 2026 BrainHuge Academy</p>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
